{
  "name": "ai-support-engine",
  "version": "0.1.0",
  "description": "Clasificador de solicitudes de soporte con motor tradicional (reglas) y motor generativo (LLM).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "compare": "node --env-file-if-exists=.env scripts/compare.js",
    "evidence": "node --env-file-if-exists=.env scripts/evidence.js"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^3.3.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}

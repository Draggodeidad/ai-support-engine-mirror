# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repositorio.
PORT=3000

# Proveedor del motor generativo: gemini | ollama
LLM_PROVIDER=gemini

# Gemini (Google AI Studio, plan gratuito): https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama (local): https://ollama.com  ->  ollama pull qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Timeout de la llamada al LLM en milisegundos
LLM_TIMEOUT_MS=30000
